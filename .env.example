# ==============================================================================
# Aegis Environment Variables (No secrets committed)
# ==============================================================================

# AI Studio Preview Runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Database (PostgreSQL + pgvector)
DATABASE_URL="postgresql://aegis:aegis@localhost:5432/aegis?schema=public"

# Cache / Rate Limiting (Upstash Redis or local Redis)
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# NextAuth (OAuth & Session)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-32-byte-random-hex"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Service-to-Service Auth (Next.js -> FastAPI 60s JWT)
SERVICE_JWT_SECRET="replace-with-64-char-service-jwt-secret"
AI_SERVICE_URL="http://localhost:8000"

# AI & Search Providers (Backend Only)
ANTHROPIC_API_KEY=""
VOYAGE_API_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""

# Observability (Optional in local dev)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
SENTRY_DSN=""
